# macOS
.DS_Store
.AppleDouble
.LSOverride

# Build artifacts (iCE40 flow)
*.vvp
*.vcd
*.json
*.asc
*.bin
*.blif
*.log

# Carve out CTF chain manifest from the *.json catch-all above. This file
# is the per-cohort sealing record (which exercise emits which flag) and
# is regenerated by scripts/lab_ctf/seal_all.py — instructors want it in
# version control even though it's a .json file.
!scripts/lab_ctf/chain.json

# Carve out YouTube ID map (consumed by scripts/prep_mkdocs.py and
# scripts/build_site.py to wire lecture segments to recorded videos).
!youtube_ids.json

# Editor / IDE
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Nix
# Build-result symlinks created by `nix build` / `nix-build` (any directory).
result
result-*
# direnv cache (created by `direnv allow` against the flake's .envrc).
.direnv/
.direnv
# Local, per-student .envrc overrides — keep machine-specific tweaks unstaged.
.envrc.local
# `nix repl`/`nix eval` scratch outputs and local GC roots.
repl-result-*
.nix-gc-roots/
# Note: flake.lock is intentionally NOT ignored — it pins the toolchain and
# must stay in version control for reproducible `nix develop` across machines.

# Python
__pycache__/
*.pyc

# Student submission artifacts (created by scripts/lab_submit.sh). These are
# per-student and should never be committed or mirrored.
day??_submission.zip
labs/**/reflection.txt

# Generated build outputs
# Generated content (rebuilt by prep_mkdocs.py)
docs_src/downloads/
docs_src/barcelona/
# Custom portal output (rebuilt by build_site.py, not deployed)
site/
# MkDocs build output
_site/
